generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String          @unique
  description         String?
  pricePerNight       Decimal         @map("price_per_night") @db.Decimal(10, 2)
  capacity            Int             @default(2)
  imageUrl            String?         @map("image_url")
  isActive            Boolean         @default(true) @map("is_active")
  sortOrder           Int             @default(0) @map("sort_order")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at")
  amenityIds          String[]        @default([]) @map("amenity_ids")
  bedType             String          @default("King") @map("bed_type")
  imageKey            String?         @map("image_key")
  isFeatured          Boolean         @default(false) @map("is_featured")
  maxNightsPerBooking Int             @default(30) @map("max_nights_per_booking")
  minGuestsAllowed    Int             @default(1) @map("min_guests_allowed")
  minNightsPerBooking Int             @default(1) @map("min_nights_per_booking")
  updatedBy           String?         @map("updated_by")
  blackoutDates       BlackoutDate[]
  bookings            Booking[]
  room_images         room_images[]
  seasonalPrices      SeasonalPrice[]

  @@index([isActive])
  @@index([isFeatured])
  @@map("rooms")
}

model Amenity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([isActive])
  @@map("amenities")
}

model StoreProduct {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  description      String?
  price            Decimal  @db.Decimal(10, 2)
  category         String   @default("general")
  imageUrl         String?  @map("image_url")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  in_stock         Boolean  @default(true)
  quantity_on_hand Int      @default(0)

  @@index([category])
  @@index([isActive])
  @@map("store_products")
}

model Booking {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId         String?  @map("room_id") @db.Uuid
  guestName      String   @map("guest_name")
  checkInDate    DateTime @map("check_in_date") @db.Date
  checkOutDate   DateTime @map("check_out_date") @db.Date
  status         String   @default("confirmed")
  createdAt      DateTime @default(now()) @map("created_at")
  bookingType    String   @default("overnight") @map("booking_type")
  depositAmount  Decimal  @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  guestEmail     String   @default("") @map("guest_email")
  guestPhone     String   @default("") @map("guest_phone")
  notes          String?
  numberOfGuests Int      @default(1) @map("number_of_guests")
  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(10, 2)
  room           Room?    @relation(fields: [roomId], references: [id])

  @@index([checkInDate, checkOutDate])
  @@index([roomId])
  @@index([status])
  @@map("bookings")
}

model AdminProfile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  role      String   @default("super_admin")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_profiles")
}

model SecurityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType String   @map("event_type")
  actor     String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("security_logs")
}

model BookingRules {
  id                        String   @id @default("singleton")
  minNightsRequired         Int      @default(1) @map("min_nights_required")
  maxNightsAllowed          Int      @default(30) @map("max_nights_allowed")
  advanceBookingDays        Int      @default(365) @map("advance_booking_days")
  checkInTime               String   @default("14:00") @map("check_in_time")
  checkOutTime              String   @default("11:00") @map("check_out_time")
  allowOvernightStay        Boolean  @default(true) @map("allow_overnight_stay")
  allowDayTour              Boolean  @default(false) @map("allow_day_tour")
  allowNightTour            Boolean  @default(false) @map("allow_night_tour")
  refundPercentage          Int      @default(100) @map("refund_percentage")
  cancellationCutoffDays    Int      @default(7) @map("cancellation_cutoff_days")
  depositRequired           Boolean  @default(true) @map("deposit_required")
  depositPercentage         Int      @default(50) @map("deposit_percentage")
  weekendSurchargePercent   Int      @default(0) @map("weekend_surcharge_percent")
  lastMinuteDiscountPercent Int      @default(0) @map("last_minute_discount_percent")
  groupDiscountThreshold    Int      @default(3) @map("group_discount_threshold")
  groupDiscountPercent      Int      @default(0) @map("group_discount_percent")
  seasonalPricingEnabled    Boolean  @default(true) @map("seasonal_pricing_enabled")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy                 String?  @map("updated_by")
  dayTourEndTime            String   @default("17:00") @map("day_tour_end_time")
  dayTourPricePerGuest      Decimal  @default(500) @map("day_tour_price_per_guest") @db.Decimal(10, 2)
  dayTourStartTime          String   @default("08:00") @map("day_tour_start_time")
  nightTourEndTime          String   @default("23:00") @map("night_tour_end_time")
  nightTourPricePerGuest    Decimal  @default(600) @map("night_tour_price_per_guest") @db.Decimal(10, 2)
  nightTourStartTime        String   @default("18:00") @map("night_tour_start_time")

  @@map("booking_rules")
}

model SeasonalPrice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId        String   @map("room_id") @db.Uuid
  seasonName    String   @map("season_name")
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  pricePerNight Decimal  @map("price_per_night") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("seasonal_prices")
}

model BlackoutDate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String   @default("Custom")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("blackout_dates")
}

model activities {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  duration       String   @default("")
  min_group_size Int      @default(1)
  max_group_size Int      @default(10)
  image_url      String?
  image_key      String?
  is_active      Boolean  @default(true)
  is_featured    Boolean  @default(false)
  sort_order     Int      @default(0)
  updated_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  @@index([is_active])
  @@index([is_featured])
}

model gallery_images {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category      String   @default("common_area")
  image_url     String
  image_key     String
  caption       String?
  display_order Int      @default(0)
  is_featured   Boolean  @default(false)
  updated_by    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  @@index([category])
  @@index([display_order])
  @@index([is_featured])
}

model room_images {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id       String   @db.Uuid
  image_url     String
  image_key     String
  caption       String?
  display_order Int      @default(0)
  is_featured   Boolean  @default(false)
  created_at    DateTime @default(now())
  rooms         Room     @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id])
}

model shop_config {
  id                   String   @id @default("shop_config")
  shop_hours           String?
  shop_location        String?
  alcohol_warning_text String?
  updated_at           DateTime @default(now())
}

model system_settings {
  id                           String   @id @default("singleton")
  house_rules                  String?
  cancellation_policy          String?
  terms_of_service             String?
  privacy_policy               String?
  about_page_content           String?
  resort_phone                 String?
  resort_email                 String?
  resort_address               String?
  hero_tagline                 String?  @default("Experience Luxury")
  hero_image_url               String?
  hero_image_key               String?
  cta_section_heading          String?
  cta_section_subtext          String?
  cta_button_text              String?  @default("Plan Your Stay")
  cta_section_visible          Boolean  @default(true)
  featured_room_ids            String[] @default([])
  testimonials_section_enabled Boolean  @default(true)
  testimonials_section_count   Int      @default(3)
  testimonials_featured_only   Boolean  @default(true)
  site_title                   String?  @default("Villa Azure Resort")
  site_description             String?
  og_image_url                 String?
  og_image_key                 String?
  updated_at                   DateTime @default(now())
  updated_by                   String?
}

model testimonials {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guest_name      String
  guest_photo     String?
  guest_photo_key String?
  rating          Int      @default(5)
  quote           String   @db.VarChar(500)
  is_featured     Boolean  @default(false)
  display_order   Int      @default(0)
  updated_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())

  @@index([display_order])
  @@index([is_featured])
}

model visitor_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ip_address String?
  user_agent String?
  path       String?
  action     String   @default("page_view")
  details    String?
  city       String?
  country    String?
  created_at DateTime @default(now())
}

// ============================================================
// MODEL: AccountActivityLog  (Rule 42 — Account Activity Log)
// ============================================================
// Per-account navigation/action trail — ONLY for authenticated accounts
// (currently: super-admin/staff via AdminProfile). Never used for
// anonymous public visitors — that's the existing visitor_logs table's
// job. accountId is never nullable here: a row with no logged-in
// account doesn't belong in this table.
model AccountActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String   @map("account_id")
  action     String // page path for a simple page view, or a specific action name
  ipAddress  String?  @map("ip_address")
  geoCity    String?  @map("geo_city")
  geoCountry String?  @map("geo_country")
  deviceType String?  @map("device_type")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@index([createdAt])
  @@map("account_activity_logs")
}

// ============================================================
// MODEL: PageViewDaily  (Rule 41 — Anonymized Traffic Analytics)
// ============================================================
// Aggregate-only counters, never a per-visitor row. Each row is one
// unique combination of date + path + referrerHost + deviceType +
// countryCode with a running viewCount — never a raw IP, never a
// session id, never anything that ties a row back to one visitor.
// NOTE: this is intentionally separate from the existing visitor_logs
// table, which already stores raw per-visit IP/path/city/country rows —
// PageViewDaily exists for fast aggregate dashboard queries without
// needing to scan/group visitor_logs on every page load.
model PageViewDaily {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date         DateTime @db.Date
  path         String
  viewCount    Int      @default(0) @map("view_count")
  referrerHost String?  @map("referrer_host")
  deviceType   String?  @map("device_type")
  countryCode  String?  @map("country_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([date, path, referrerHost, deviceType, countryCode])
  @@map("page_views_daily")
}
