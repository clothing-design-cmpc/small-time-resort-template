// FILE: prisma/schema.prisma
// PURPOSE:
// Defines the database schema for Villa Azure Resort using Prisma ORM
// against the Supabase Postgres database. All schema changes go through
// `npx prisma db push` (terminal only) — never the Supabase SQL Editor.
//
// Connection setup (Prisma 7 — connection URLs live in prisma.config.mjs,
// NOT in this file):
//   prisma.config.mjs -> datasource.url = DIRECT_URL (session pooler,
//                        port 5432) — used by the CLI for db push/generate.
//   services/prisma.js -> runtime PrismaClient uses a driver adapter
//                        (@prisma/adapter-pg) pointed at DATABASE_URL
//                        (transaction pooler, port 6543).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs are defined in prisma.config.mjs (datasource.url),
// NOT here. Keeping url/directUrl in this block causes P1012 validation error.
datasource db {
  provider = "postgresql"
}

// ============================================================
// MODEL: Room  (Rooms & Villas section)
// ============================================================
model Room {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String    @unique
  description    String?
  pricePerNight  Decimal   @map("price_per_night") @db.Decimal(10, 2)
  capacity       Int       @default(2)
  imageUrl       String?   @map("image_url")
  imageKey       String?   @map("image_key") // R2 object key, needed to delete the old file on replace
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")

  // --- Content Management fields (Super-Admin Rooms Management, blueprint Page 1) ---
  // NOTE: this model used to carry its own minNightsPerBooking /
  // maxNightsPerBooking / minGuestsAllowed override fields ("Booking
  // Limits" section on the room edit form). They were removed — every
  // room silently carried a concrete default value, so editing the
  // resort-wide Booking Rule never actually took effect unless every
  // room was also edited by hand. Nights/guest limits now come from
  // whichever BookingRule is marked active (see model BookingRule) —
  // a single source of truth, never overwritten by a room's own form.
  bedType             String    @default("King") @map("bed_type") // "King", "Twin", "Double", "Sofa Bed"
  isFeatured          Boolean   @default(false) @map("is_featured") // shown on visitor homepage
  amenityIds          String[]  @default([]) @map("amenity_ids") // Amenity.id values mapped to this room
  updatedBy           String?   @map("updated_by") // super-admin user id who last saved this room

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  bookings       Booking[]
  seasonalPrices SeasonalPrice[]
  blackoutDates  BlackoutDate[]
  roomImages     RoomImage[]

  // Index for the visitor "Rooms" list and homepage featured-rooms query —
  // both filter by isActive/isFeatured on every no-cache request.
  @@index([isActive])
  @@index([isFeatured])
  @@map("rooms")
}

// ============================================================
// MODEL: RoomImage  (Rooms Management — Room Gallery sub-page,
// blueprint Page 1)
// ============================================================
// Multi-image gallery per room, separate from Room.imageUrl (the
// single "Main Image" shown on cards/lists). setMain copies a
// RoomImage's url/key onto the parent Room row; isFeatured marks an
// image for the room's featured highlights strip on the visitor page.
model RoomImage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  imageUrl     String   @map("image_url")
  imageKey     String   @map("image_key") // R2 object key, needed to delete the old file on replace
  caption      String?
  displayOrder Int      @default(0) @map("display_order")
  isFeatured   Boolean  @default(false) @map("is_featured")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([roomId])
  @@map("room_images")
}

// ============================================================
// MODEL: Amenity  (Resort Amenities section)
// ============================================================
model Amenity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  icon        String?  // icon identifier (e.g. lucide icon name) rendered by the frontend
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([isActive])
  @@map("amenities")
}

// ============================================================
// MODEL: StoreProduct  (Resort Shop — browse-only, no cart/checkout)
// ============================================================
model StoreProduct {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  category       String   @default("general")
  imageUrl       String?  @map("image_url")
  imageKey       String?  @map("image_key") // R2 object key, needed to delete the old file on replace
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  // Shop Management form (blueprint Page 3) reads/writes these two on
  // every create and update — see app/api/superAdmin/content/shop/route.js
  // and ShopProductForm.jsx. Previously missing from this model, which
  // caused every product save to fail with a Prisma "Unknown argument" error.
  inStock        Boolean  @default(true) @map("in_stock")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  createdAt      DateTime @default(now()) @map("created_at")

  // Shop page filters by category tab and hides inactive products —
  // both hit on every visitor no-cache request.
  @@index([category])
  @@index([isActive])
  @@map("store_products")
}

// ============================================================
// MODEL: ShopConfig  (Resort Shop — Shop Configuration panel,
// blueprint Page 3)
// ============================================================
// Singleton table — the app always reads/writes the single row with
// the well-known id "shop_config" (same pattern as BookingRules and
// SystemSettings below), never creates a second row. Was previously
// referenced by app/api/superAdmin/content/shop/config/route.js with
// no matching model, which caused every config read/save to fail.
model ShopConfig {
  id                 String   @id @default("shop_config")
  shopHours          String?  @map("shop_hours")
  shopLocation       String?  @map("shop_location")
  alcoholWarningText String?  @map("alcohol_warning_text")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("shop_config")
}

// ============================================================
// MODEL: Booking  (Booked Dates section + Reserve Your Villa date picker)
// ============================================================
// A single confirmed stay: checkInDate (inclusive) through checkOutDate
// (exclusive, standard hotel convention — the checkout day itself is not
// "occupied" and can be someone else's check-in day). The Booked Dates
// carousel/calendar and the Reserve Your Villa date picker both derive
// their "already reserved" dates by expanding every active Booking's
// range server-side (see app/api/bookings/dates/route.js) instead of the
// old module-level BOOKED_DATES constant.
model Booking {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId         String?  @map("room_id") @db.Uuid
  guestName      String   @map("guest_name")
  guestEmail     String   @default("") @map("guest_email")
  guestPhone     String   @default("") @map("guest_phone")
  numberOfGuests Int      @default(1) @map("number_of_guests")
  bookingType    String   @default("overnight") @map("booking_type") // overnight | day_tour | night_tour — mirrors BookingRules.allow* flags
  checkInDate    DateTime @map("check_in_date") @db.Date
  checkOutDate   DateTime @map("check_out_date") @db.Date
  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(10, 2)
  depositAmount  Decimal  @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  notes          String?
  status         String   @default("confirmed") // confirmed | cancelled
  createdAt      DateTime @default(now()) @map("created_at")

  room Room? @relation(fields: [roomId], references: [id])

  // Availability calendar and blackout checks filter by roomId + status/date
  // range on every booking-form load — this is the hottest query path.
  @@index([roomId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
  @@map("bookings")
}

// ============================================================
// MODEL: WalkInInquiry  (floating chat widget lead capture)
// ============================================================
// Captured from the visitor site's floating "Chat with us" widget —
// a guest fills in their name and phone number (IP is captured
// server-side, never trusted from the client) so staff can call them
// back about a walk-in or phone-in reservation. This is a lead, not a
// confirmed Booking — staff convert it into a real Booking manually
// once the reservation is agreed over the call (see the Bookings admin
// page), and mark it "converted" here for their own tracking.
model WalkInInquiry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestName  String   @map("guest_name")
  guestPhone String   @map("guest_phone")
  ipAddress  String?  @map("ip_address")
  status     String   @default("new") // new | contacted | converted
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("walkin_inquiries")
}

// ============================================================
// MODEL: AdminProfile  (Super Admin accounts)
// ============================================================
// The `id` must match an existing Supabase Auth user's UID (created via
// Supabase Auth, not via this table). Prisma does not manage the
// auth.users table directly — this table only stores role/profile
// metadata for a user that already exists in Supabase Auth.
model AdminProfile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  role      String   @default("super_admin")
  // Distinguishes the actual resort owner from any other staff account
  // that might later get a super_admin login (e.g. a front-desk
  // manager). role alone can't do this — every admin account defaults
  // to "super_admin" regardless of who they are. Gates access to
  // owner-only pages like the Vault Passphrase settings page, which
  // reveals the hidden vault recovery URL (hash-derived, changes on
  // every rotation) — something that should stay known to the owner
  // alone, not every staff login.
  isOwner   Boolean  @default(false) @map("is_owner")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_profiles")
}

// ============================================================
// MODEL: SecurityLog  (Security event / audit log — see services/securityLog.js)
// ============================================================
// Append-only. Every row is one security-relevant event: a login
// attempt (success or failure), a rate limit being hit, or a
// super-admin performing a sensitive create/update/delete. Never
// updated or deleted by the app itself — this is the record an admin
// reviews after the fact to answer "what happened and who did it."
model SecurityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType String   @map("event_type") // login_success | login_failed | admin_login_denied | rate_limit_hit | admin_action | sql_injection_attempt | system_retention_purge | gatekeeper_breach | vault_passphrase_rotated | vault_passphrase_set | gatekeeper_vault_login_success | gatekeeper_vault_login_failed
  actor     String?  // email attempted/used, or the admin's full name for admin_action rows
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  details   String?  @db.Text // human-readable summary, e.g. "Cancelled booking for Juan Dela Cruz"

  // --- Device Fingerprinting (Rule 38) — parsed from userAgent at write time ---
  deviceType        String? @map("device_type") // desktop | mobile | tablet | bot | unknown
  browserName       String? @map("browser_name")
  osName            String? @map("os_name")
  deviceFingerprint String? @map("device_fingerprint") // sha256(userAgent + actor), used for new-device detection
  isNewDevice       Boolean @default(false) @map("is_new_device") // true if this fingerprint was never seen before for this actor

  // --- Geolocation (Rule 38) — resolved via self-hosted MaxMind GeoIP2, see services/geoip.js ---
  country     String? // full country name, e.g. "Philippines"
  countryCode String? @map("country_code") // ISO 3166-1 alpha-2, e.g. "PH"
  city        String?
  latitude    Float?
  longitude   Float?

  // --- Anomaly Detection (Rule 38) — impossible-travel and new-device flags computed in services/securityLog.js ---
  isAnomalous   Boolean @default(false) @map("is_anomalous")
  anomalyReason String? @map("anomaly_reason") @db.Text // e.g. "Impossible travel: Manila -> Berlin in 4 minutes (implies 9800 km/h)"

  createdAt DateTime @default(now()) @map("created_at")

  // Speeds up the two queries the anomaly detector runs on every write:
  // "most recent row for this actor" and "most recent fingerprint for this actor".
  @@index([actor, createdAt])
  @@map("security_logs")
}

// ============================================================
// MODEL: BlockedIp  (3-Gatekeeper breach response — auto/manual IP block)
// ============================================================
// One row per blocked IP address. Checked by middleware.js on every
// single request (visitor + super-admin alike) before anything else
// runs — a blocked IP gets a plain 403 and never reaches any page or
// API route. Rows are almost always written automatically by
// services/breachResponse.js the instant a gatekeeper trips, but the
// `blockedBy` field also supports a manual block added directly by a
// super-admin later if this project adds that UI.
model BlockedIp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipAddress String   @unique @map("ip_address")
  reason    String   @db.Text
  blockedBy String   @default("system") @map("blocked_by") // "system" (auto, gatekeeper trip) or a super-admin uid
  gatekeeper Int?    @map("gatekeeper") // 1, 2, or 3 — which gate this IP tripped, null for manual blocks
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ipAddress])
  @@map("blocked_ips")
}

// ============================================================
// MODEL: BreachEvent  (3-Gatekeeper breach response — incident record)
// ============================================================
// One row per gatekeeper trip. Drives three things at once: the red
// takeover banner shown to guests (via SystemSettings.breachLockdown),
// the alert banner shown to super-admin on next login, and the trail
// the hidden recovery page reads from so a super-admin can see exactly
// what happened before importing the pre-breach backup.
model BreachEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gatekeeper     Int       @map("gatekeeper") // 1 = login brute force, 2 = SQL injection attempt, 3 = anomalous admin login
  ipAddress      String?   @map("ip_address")
  details        String    @db.Text
  backupTriggered Boolean  @default(false) @map("backup_triggered") // true once database-backup.yml was dispatched
  emailSent      Boolean   @default(false) @map("email_sent")
  vaultPassphraseRotated Boolean @default(false) @map("vault_passphrase_rotated") // true once a fresh vault passphrase was generated + emailed (Gatekeeper 1/2 only — see services/breachResponse.js)
  resolved       Boolean   @default(false) // true once a super-admin ends the lockdown from the recovery page
  resolvedBy     String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([resolved])
  @@map("breach_events")
}

// ============================================================
// MODEL: BackupLog  (Database Backup history — see scripts/runBackup.js)
// ============================================================
// One row per backup run, written by the standalone backup script
// (never by the live app itself — see the "decoupled from live
// traffic" note in scripts/runBackup.js). Lets an admin see backup
// history and confirm both destinations (R2 + Google Drive) actually
// received a copy on the Backups admin page.
// ============================================================
// MODEL: ActivityArchiveLog  (Activity Feed — 100-page auto-archive)
// ============================================================
// One row per automatic Activity Feed archive event. Written by
// services/activityArchive.js the instant a VisitorLog +
// AccountActivityLog snapshot has been uploaded to Google Drive AND
// deleted from both source tables. The Activity Feed page reads the
// single most recent row here to show the "just archived" banner +
// Open in Google Drive button after a fresh archive fires.
model ActivityArchiveLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName      String   @map("file_name") // e.g. "JulyToAugust-activityfeed-2026.sql"
  driveFileId   String   @map("drive_file_id")
  driveViewLink String   @map("drive_view_link") @db.Text
  recordCount   Int      @map("record_count")
  rangeStart    DateTime @map("range_start")
  rangeEnd      DateTime @map("range_end")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("activity_archive_logs")
}

model BackupLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status         String    @default("running") // running | success | failed
  // What caused this run: "nightly" (2 AM cron), "manual" ("Run Backup
  // Now" button or someone pressing "Run workflow" in GitHub directly),
  // or "pre_wipe" (fired the instant a super-admin scheduled a
  // "Back up first, then wipe" — see pre-wipe-backup.yml). Set by
  // scripts/runBackup.js from the TRIGGER_SOURCE env var each workflow
  // passes in — never inferred after the fact.
  triggerSource  String    @default("manual") @map("trigger_source")
  fileSizeBytes  Int?      @map("file_size_bytes")
  r2Key          String?   @map("r2_key")
  r2Url          String?   @map("r2_url") @db.Text
  driveFileId    String?   @map("drive_file_id")
  driveViewLink  String?   @map("drive_view_link") @db.Text
  errorMessage   String?   @map("error_message") @db.Text
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@map("backup_logs")
}

// ============================================================
// MODEL: SqlImportLog  (Backups page — "Import SQL to Fix Database")
// ============================================================
// One row per SQL restore triggered by a super-admin. The row is
// created with status "running" by the API route the instant the
// upload finishes, then updated to "success"/"failed" by
// scripts/runRestore.js once GitHub Actions actually applies the file
// against DIRECT_URL — same "decoupled from live traffic" pattern as
// BackupLog (Rule 40.1): the actual psql restore never runs inside a
// live Next.js request.
model SqlImportLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status         String    @default("running") // running | success | failed
  fileName       String    @map("file_name")
  fileSizeBytes  Int?      @map("file_size_bytes")
  sourceUrl      String    @map("source_url") @db.Text // R2 URL of the uploaded .sql/.sql.gz file
  triggeredBy    String?   @map("triggered_by") // super-admin uid who uploaded the file
  errorMessage   String?   @map("error_message") @db.Text
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@map("sql_import_logs")
}

// ============================================================
// MODEL: BookingRules  (Booking Rules & Configuration, blueprint Page 7)
// ============================================================
// Singleton table — the app always reads/writes the single row with
// the well-known id "singleton" (see app/api/superAdmin/settings/
// booking-rules/route.js), never creates a second row.
// Previously a locked singleton (id always "singleton", exactly one row).
// Super-admin could only ever edit "the" settings, never create another
// set — and the confusing part was that per-room overrides on the Room
// model could silently take precedence over whatever was configured
// here. Now a normal multi-row model: super-admin can create as many
// named rule sets as needed (e.g. "Regular Season", "Peak Season Rules"),
// edit or delete any of them, and mark exactly one `isActive` — that one
// alone is what the visitor booking flow and pricing engine read from.
model BookingRule {
  id     String  @id @default(cuid())
  name   String  @unique @default("Default Rules") // e.g. "Default Rules", "Holiday Season Rules"
  isActive Boolean @default(false) @map("is_active") // exactly one row should be true at a time — enforced in the activate API route, not the DB

  // --- Section 1: General Booking Settings ---
  minNightsRequired  Int    @default(1) @map("min_nights_required")
  maxNightsAllowed   Int    @default(30) @map("max_nights_allowed")
  advanceBookingDays Int    @default(365) @map("advance_booking_days") // guests can book at most this many days ahead
  checkInTime        String @default("14:00") @map("check_in_time") // 24h "HH:mm"
  checkOutTime       String @default("11:00") @map("check_out_time") // 24h "HH:mm"

  // --- Booking Types (extension beyond the base blueprint, per admin request) ---
  allowOvernightStay Boolean @default(true) @map("allow_overnight_stay")
  allowDayTour       Boolean @default(false) @map("allow_day_tour")
  allowNightTour     Boolean @default(false) @map("allow_night_tour")

  // --- Day Tour settings — only meaningful when allowDayTour is true.
  //     A Day Tour is a same-day, no-room, no-overnight visit (guest
  //     uses the pool/facilities during these hours only, at a flat
  //     per-guest rate — not the room's per-night price). ---
  dayTourStartTime      String  @default("08:00") @map("day_tour_start_time") // 24h "HH:mm"
  dayTourEndTime        String  @default("17:00") @map("day_tour_end_time") // 24h "HH:mm"
  dayTourPricePerGuest  Decimal @default(500) @map("day_tour_price_per_guest") @db.Decimal(10, 2)

  // --- Night Tour settings — only meaningful when allowNightTour is
  //     true. Same idea as Day Tour but for an evening window. ---
  nightTourStartTime     String  @default("18:00") @map("night_tour_start_time") // 24h "HH:mm"
  nightTourEndTime       String  @default("23:00") @map("night_tour_end_time") // 24h "HH:mm"
  nightTourPricePerGuest Decimal @default(600) @map("night_tour_price_per_guest") @db.Decimal(10, 2)

  // --- Section 2: Cancellation Policy ---
  refundPercentage       Int @default(100) @map("refund_percentage") // % refunded if cancelled before the cutoff
  cancellationCutoffDays Int @default(7) @map("cancellation_cutoff_days") // days before check-in for full refund

  // --- Section 3: Deposit & Payment ---
  depositRequired   Boolean @default(true) @map("deposit_required")
  depositPercentage Int     @default(50) @map("deposit_percentage") // % of total held as deposit

  // --- Section 4: Pricing Modifiers ---
  weekendSurchargePercent   Int @default(0) @map("weekend_surcharge_percent") // extra % on Fri/Sat nights
  lastMinuteDiscountPercent Int @default(0) @map("last_minute_discount_percent") // % off if booked within a few days
  groupDiscountThreshold    Int @default(3) @map("group_discount_threshold") // min rooms booked together to qualify
  groupDiscountPercent      Int @default(0) @map("group_discount_percent")

  // --- Section 5: Seasonal Pricing toggle ---
  seasonalPricingEnabled Boolean @default(true) @map("seasonal_pricing_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") // super-admin user id who last saved these rules

  @@index([isActive])
  @@map("booking_rules")
}

// ============================================================
// MODEL: SeasonalPrice  (Booking Rules — Section 5: Seasonal Pricing)
// ============================================================
model SeasonalPrice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId        String   @map("room_id") @db.Uuid
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seasonName    String   @map("season_name") // "Peak Season", "Shoulder", "Off-Season", etc.
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  pricePerNight Decimal  @map("price_per_night") @db.Decimal(10, 2) // overrides the room's default price for this range
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([roomId])
  @@map("seasonal_prices")
}

// ============================================================
// MODEL: BlackoutDate  (Booking Rules — Section 6: Blackout Dates)
// ============================================================
model BlackoutDate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String   @default("Custom") // "Cleaning" | "Maintenance" | "Private" | "Custom"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([roomId])
  @@map("blackout_dates")
}

// ============================================================
// MODEL: Activity  (Activities Management, blueprint Page 4)
// ============================================================
model Activity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String?
  duration     String   @default("") // e.g. "2 hours", "Half day"
  minGroupSize Int      @default(1) @map("min_group_size")
  maxGroupSize Int      @default(10) @map("max_group_size")
  imageUrl     String?  @map("image_url")
  imageKey     String?  @map("image_key") // R2 object key, needed to delete the old file on replace
  isActive     Boolean  @default(true) @map("is_active")
  isFeatured   Boolean  @default(false) @map("is_featured")
  sortOrder    Int      @default(0) @map("sort_order")
  updatedBy    String?  @map("updated_by") // super-admin user id who last saved this activity
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([isFeatured])
  @@map("activities")
}

// ============================================================
// MODEL: Testimonial  (Testimonials Management, blueprint Page 5)
// ============================================================
model Testimonial {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestName    String   @map("guest_name")
  guestPhoto   String?  @map("guest_photo") // R2 image URL, optional
  guestPhotoKey String? @map("guest_photo_key") // R2 object key, needed to delete the old file on replace
  rating       Int      @default(5) // 1-5 stars
  quote        String   @db.VarChar(500)
  isFeatured   Boolean  @default(false) @map("is_featured") // shown on homepage
  displayOrder Int      @default(0) @map("display_order")
  updatedBy    String?  @map("updated_by") // super-admin user id who last saved this testimonial
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isFeatured])
  @@index([displayOrder])
  @@map("testimonials")
}

// ============================================================
// MODEL: GalleryImage  (Gallery Management, blueprint Page 6)
// ============================================================
model GalleryImage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category     String   @default("common_area") // "bedroom" | "bathroom" | "common_area" | "outdoor" | "amenity"
  imageUrl     String   @map("image_url")
  imageKey     String   @map("image_key") // R2 object key, needed to delete the old file on replace
  caption      String?
  displayOrder Int      @default(0) @map("display_order")
  isFeatured   Boolean  @default(false) @map("is_featured") // shows on homepage/featured section
  updatedBy    String?  @map("updated_by") // super-admin user id who last saved this image
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([category])
  @@index([displayOrder])
  @@index([isFeatured])
  @@map("gallery_images")
}

// ============================================================
// MODEL: SystemSettings  (Shop Config, Policies, Homepage,
// Contact Info & SEO — blueprint Pages 3, 8, 9)
// ============================================================
// Singleton table — the app always reads/writes the single row with
// the well-known id "singleton" (same pattern as BookingRules above),
// never creates a second row.
model SystemSettings {
  id String @id @default("singleton")

  // Shop Config (hours/location/alcohol warning) lives on the ShopConfig
  // model above, not here — see ShopConfig for that data.

  // --- Maintenance Mode (breach response / planned downtime banner) ---
  // When true, every /visitor page renders a full-site banner via
  // components/shared/MaintenanceBanner.jsx instead of hiding the
  // problem from guests. Toggled from the Dashboard's Maintenance Mode
  // card — see app/api/superAdmin/settings/maintenance/route.js.
  maintenanceMode    Boolean @default(false) @map("maintenance_mode")
  maintenanceMessage String? @map("maintenance_message")

  // --- Breach Lockdown (3-Gatekeeper system, see services/breachResponse.js) ---
  // Separate from plain maintenanceMode above: when true, the visitor
  // site shows a full-page breach takeover (not just a banner over a
  // working site — see components/shared/BreachLockdownScreen.jsx) and
  // the super-admin dashboard shows a persistent red alert until the
  // active BreachEvent is resolved from the hidden recovery page.
  breachLockdown      Boolean @default(false) @map("breach_lockdown")

  // --- Post-Wipe Lockdown (scripts/runDatabaseWipe.js) ---
  // Separate from breachLockdown above: flipped on ONLY by the wipe
  // executor the instant TRUNCATE actually succeeds — never by a
  // gatekeeper. Unlike breachLockdown, super-admin access is ALSO
  // fully blocked (proxy.js), and the admin's session cookie is
  // cleared on their very next request — the truncated tables include
  // account_activity_logs, so continuing to browse as if nothing
  // happened isn't safe to allow. Only reachable to lift from the
  // hidden vault recovery page (app/api/admin/post-wipe-lockdown),
  // same "works even when the regular session is untrusted" reasoning
  // breachLockdown already relies on.
  postWipeLockdown   Boolean   @default(false) @map("post_wipe_lockdown")
  postWipeLockdownAt DateTime? @map("post_wipe_lockdown_at")
  breachActiveEventId String? @map("breach_active_event_id") @db.Uuid

  // --- Policies & Pages (Page 8) — rich text / markdown content ---
  houseRules         String? @map("house_rules")
  bookingPolicies    String? @map("booking_policies")
  cancellationPolicy String? @map("cancellation_policy")
  termsOfService      String? @map("terms_of_service")
  privacyPolicy       String? @map("privacy_policy")
  aboutPageContent    String? @map("about_page_content")

  // --- Check-In / Check-Out (Policies page) ---
  checkInTime  String? @default("2:00 PM") @map("check_in_time")
  checkOutTime String? @default("12:00 PM") @map("check_out_time")
  checkInNote  String? @map("check_in_note")
  checkOutNote String? @map("check_out_note")

  // --- Contact Info ---
  resortPhone   String? @map("resort_phone")
  resortEmail   String? @map("resort_email")
  resortAddress String? @map("resort_address")

  // --- Homepage Customization (Page 9) ---
  heroTagline       String? @default("Experience Luxury") @map("hero_tagline")
  heroImageUrl      String? @map("hero_image_url")
  heroImageKey      String? @map("hero_image_key") // R2 object key, needed to delete the old file on replace
  ctaSectionHeading String? @map("cta_section_heading")
  ctaSectionSubtext String? @map("cta_section_subtext")
  ctaButtonText     String? @default("Plan Your Stay") @map("cta_button_text")
  ctaSectionVisible Boolean @default(true) @map("cta_section_visible")

  // Featured room selection for the homepage — up to 3 Room IDs, in order.
  featuredRoomIds String[] @default([]) @map("featured_room_ids")

  // --- About Section Differentiators (3 fixed cards under the About story) ---
  aboutDifferentiator1Title String? @map("about_differentiator1_title")
  aboutDifferentiator1Body  String? @map("about_differentiator1_body")
  aboutDifferentiator2Title String? @map("about_differentiator2_title")
  aboutDifferentiator2Body  String? @map("about_differentiator2_body")
  aboutDifferentiator3Title String? @map("about_differentiator3_title")
  aboutDifferentiator3Body  String? @map("about_differentiator3_body")

  testimonialsSectionEnabled  Boolean @default(true) @map("testimonials_section_enabled")
  testimonialsSectionCount    Int     @default(3) @map("testimonials_section_count") // 3, 6, or 9
  testimonialsFeaturedOnly    Boolean @default(true) @map("testimonials_featured_only")

  // --- SEO & Metadata ---
  siteTitle       String? @default("Villa Azure Resort") @map("site_title")
  siteDescription String? @map("site_description")
  ogImageUrl      String? @map("og_image_url")
  ogImageKey      String? @map("og_image_key") // R2 object key, needed to delete the old file on replace

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") // super-admin user id who last saved these settings

  @@map("system_settings")
}

// ============================================================
// MODEL: VisitorLog  (visitor page-view + notable-action tracking)
// ============================================================
// One row per tracked visitor event — either a routine page view or a
// notable transaction (e.g. submitting a booking). Includes a
// best-effort city/country lookup for the Visitor Logs admin page.
model VisitorLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  path      String?
  action    String   @default("page_view")
  details   String?
  city      String?
  country   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("visitor_logs")
}

// ============================================================
// MODEL: AccountActivityLog  (Rule 42 — Account Activity Log)
// ============================================================
// Per-account navigation/action trail — ONLY for authenticated accounts
// (currently: super-admin/staff via AdminProfile). Never used for
// anonymous public visitors — that's VisitorLog's job. accountId is
// never nullable here: a row with no logged-in account doesn't belong
// in this table.
model AccountActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String   @map("account_id")
  action     String // page path for a simple page view, or a specific action name
  ipAddress  String?  @map("ip_address")
  geoCity    String?  @map("geo_city")
  geoCountry String?  @map("geo_country")
  deviceType String?  @map("device_type")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@index([createdAt])
  @@map("account_activity_logs")
}

// ============================================================
// MODEL: PageViewDaily  (Rule 41 — Anonymized Traffic Analytics)
// ============================================================
// Aggregate-only counters, never a per-visitor row. Each row is one
// unique combination of date + path + referrerHost + deviceType +
// countryCode with a running viewCount — never a raw IP, never a
// session id, never anything that ties a row back to one visitor.
// Intentionally separate from VisitorLog, which already stores raw
// per-visit IP/path/city/country rows — PageViewDaily exists for fast
// aggregate dashboard queries without needing to scan/group
// VisitorLog on every page load.
model PageViewDaily {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date         DateTime @db.Date
  path         String
  viewCount    Int      @default(0) @map("view_count")
  referrerHost String?  @map("referrer_host")
  deviceType   String?  @map("device_type")
  countryCode  String?  @map("country_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([date, path, referrerHost, deviceType, countryCode])
  @@map("page_views_daily")
}

// ============================================================
// MODEL: Vault  (second-factor OTP only — id "vault")
// ============================================================
// passphraseHash used to live on this same row. It has been split out
// into its own table (VaultPassphrase, below) so a truncate/wipe of
// this table can never also take out the passphrase, and so the two
// credentials can rotate independently of each other.
//
// otpCodeHash/otpExpiresAt/otpAttempts — services/vaultOtp.js's second
//                    factor (the emailed one-time code). A successful
//                    verify NULLS these three fields back out instead of
//                    deleting the row — the row must survive across
//                    verifies.
model Vault {
  id              String    @id @default("vault")
  otpCodeHash     String?   @map("otp_code_hash")
  otpExpiresAt    DateTime? @map("otp_expires_at")
  otpAttempts     Int       @default(0) @map("otp_attempts")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("vault")
}

// ============================================================
// MODEL: VaultPassphrase  (first factor — split out from Vault so it
// has its own table, on one singleton row: id "vault_passphrase")
// ============================================================
// passphraseHash — services/vaultAuth.js's first factor. Starts out
//                  unset (falls back to VAULT_PASSPHRASE_HASH env var)
//                  until the first generate/rotation writes a value
//                  here. Read by getEffectivePassphraseHash() and
//                  written by rotateVaultPassphrase() — never read or
//                  written anywhere else.
// expiresAt      — set to 30 days past whenever passphraseHash was
//                  last written (manual generate from super-admin >
//                  vault-passphrase, OR the automatic 30-day rotation
//                  at app/api/system-vault-setup/auto-rotate). Read by
//                  isVaultPassphraseExpired() to decide whether the
//                  next auto-rotate run should generate a new one.
model VaultPassphrase {
  id              String    @id @default("vault_passphrase")
  passphraseHash  String?   @map("passphrase_hash")
  expiresAt       DateTime? @map("expires_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("vault_passphrase")
}

// ============================================================
// MODEL: GatekeeperVaultPassphrase  (hidden Gatekeeper Tester page)
// ============================================================
// Singleton row (always id: "gatekeeper_vault_passphrase"), same shape
// and rotation pattern as VaultPassphrase above but a completely
// separate secret — services/gatekeeperVaultAuth.js never reads or
// writes VaultPassphrase, and vice versa. Gates only the hidden
// Gatekeeper Tester at app/gatekeeper-vault/[gatekeeperSlug]/.
model GatekeeperVaultPassphrase {
  id              String    @id @default("gatekeeper_vault_passphrase")
  passphraseHash  String?   @map("passphrase_hash")
  expiresAt       DateTime? @map("expires_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("gatekeeper_vault_passphrase")
}

// ============================================================
// MODEL: DatabaseWipeRequest  (Backups page — "Danger Zone: Wipe Database")
// ============================================================
// One row per wipe request. Only ever one row with status "pending" at
// a time (enforced in services/databaseWipeRequest.js's
// initiateWipeRequest(), not a DB constraint). A 24-hour grace period
// sits between request and execution specifically so a super-admin has
// time to reconsider or cancel — the actual TRUNCATE (and the pre-wipe
// backup, if chosen) only ever runs decoupled, on GitHub Actions
// (scripts/runDatabaseWipe.js), same "never inside a live request"
// guarantee BackupLog already relies on (Rule 40.1).
model DatabaseWipeRequest {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status       String  @default("pending") // pending | cancelled | completed | failed
  backupOption String  @map("backup_option") // "with_backup" | "without_backup" — the super-admin's own choice, never forced
  requestedBy  String  @map("requested_by") // AdminProfile.id (uid) who initiated the wipe

  requestedAt DateTime  @default(now()) @map("requested_at")
  scheduledAt DateTime  @map("scheduled_at") // requestedAt + 24 hours — earliest the wipe can execute

  // Set only when the super-admin clicks "Continue" on the blocking
  // grace-period modal (shown once time remaining <= 2 hours). The
  // executor script never truncates anything until this is set —
  // reaching scheduledAt with this still null leaves the request
  // paused indefinitely, awaiting a super-admin to actually see and
  // resolve the modal, rather than proceeding unattended.
  finalConfirmedAt DateTime? @map("final_confirmed_at")

  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by")

  backupLogId  String?   @map("backup_log_id") @db.Uuid // set if backupOption was "with_backup" and the pre-wipe backup succeeded
  errorMessage String?   @map("error_message") @db.Text
  completedAt  DateTime? @map("completed_at")

  // Set the moment the app itself proactively dispatches the executor
  // workflow (see GET /api/superAdmin/wipe) — belt-and-suspenders
  // alongside GitHub's own 15-minute `schedule:` cron, since a
  // non-technical owner should never depend on that cron's timing (or
  // on someone manually pressing "Run workflow" in GitHub). Prevents
  // dispatching more than once as the status endpoint keeps getting
  // polled every 30 seconds while the request sits due+confirmed.
  autoDispatchedAt DateTime? @map("auto_dispatched_at")

  @@map("database_wipe_requests")
}
